DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.yourdomain.com
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://app.yourdomain.com
AUTH_TOKEN_MAX_AGE=1800
AUTH_REFRESH_MAX_AGE=1209600
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SETUSTOCK_DEMO_MODE=false
ATTACHMENT_MAX_MB=10

# PostgreSQL is recommended for production.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=setustock
DB_USER=setustock
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Optional live integrations. Keep secrets on the backend only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GST_PROVIDER_API_KEY=

# Login protection and password-reset email
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=8
